services:
  tele:
    image: mlan/asterisk:xtra
    network_mode: bridge                    # Only here to help testing
    cap_add:
      - sys_ptrace                          # Only here to help testing
      - net_admin                           # Allow NFT, used by AutoBan
      - net_raw                             # Allow NFT, used by AutoBan
    ports:
      - "${SMS_PORT-8080}:${WEBSMSD_PORT:-80}" # WEBSMSD port mapping
      - "5060:5060/udp"                     # SIP UDP port
      - "5060:5060"                         # SIP TCP port
      - "5061:5061"                         # SIP TLS port
      - "10000-10099:10000-10099/udp"       # RTP ports
    environment:
      - SYSLOG_LEVEL=${SYSLOG_LEVEL-4}      # Logging
      - HOSTNAME=${TELE_SRV-tele}.${DOMAIN-docker.localhost}
      - PULSE_SERVER=unix:/run/pulse/socket # Use host audio
      - PULSE_COOKIE=/run/pulse/cookie      # Use host audio
      - WEBSMSD_PORT=${WEBSMSD_PORT-80}     # WEBSMSD internal port
    volumes:
      #- ./srv:/srv                      # Persistent storage
      - ./pulse:/run/pulse:rshared          # Use host audio
      - /etc/localtime:/etc/localtime:ro    # Use host timezone
      - ./CAcert.cer:/tmp/CAcert.cer
      - ./fixssl:/usr/bin/fixssl
      - ./app/:/app/
      - ./sound:/var/lib/asterisk/sounds/custom
      - ./config:/srv/etc/asterisk
#      - ./extensions.conf:/srv/etc/asterisk/extensions.conf
#      - ./extensions_custom.conf:/srv/etc/asterisk/extensions_custom.conf
#      - ./pjsip.conf:/srv/etc/asterisk/pjsip.conf
      - ./app:/var/lib/asterisk/agi-bin
        # networks:
        # - asterisk-net
  ollama:
    image: ollama/ollama
    volumes:
      - ./data:/root/.ollama
      - ./CAcert.cer:/tmp/CAcert.cer
      - ./install:/usr/bin/install
      - ./app:/app
    networks:
      frontend:
        ipv4_address: ${IP_FRONT}
    ports:
      - 11434:11434
networks:
  frontend:
    name: ${NETWORK}
    external: true
  backend:
    internal: true
    #  asterisk-net:
    #driver: bridge   
    #volumes:
    #  tele-conf:                                # Persistent storage
